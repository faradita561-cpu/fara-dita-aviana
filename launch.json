{
    // Konfigurasi Debug & Jalankan Portofolio Fara Dita Aviana
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Buka Portofolio di Chrome (Langsung)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Buka Portofolio di Microsoft Edge (Langsung)",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Launch Chrome against localhost:8080",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}